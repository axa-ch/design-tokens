{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "build.ts",
    "config.ts",
    "formats/**/*.ts",
    "parsers/**/*.ts",
    "platforms/**/*.ts"
  ]
}
